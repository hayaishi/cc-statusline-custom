{
  "name": "cc-statusline-custom",
  "version": "0.1.0",
  "description": "Custom statusline integration for Claude Code",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "cc-statusline-custom": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "imports": {
    "@/*": "./dist/*"
  },
  "files": [
    "dist",
    "config.presets.yml"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "postinstall": "test -f node_modules/.bin/tsc && npm run build || echo 'Skipping build: TypeScript not available'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "tsx ./tools/dev-check.ts all",
    "check:lint": "tsx ./tools/dev-check.ts lint",
    "check:typecheck": "tsx ./tools/dev-check.ts typecheck",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "claude-code",
    "statusline",
    "cli"
  ],
  "author": "hayaishi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayaishi/cc-statusline-custom.git"
  },
  "bugs": {
    "url": "https://github.com/hayaishi/cc-statusline-custom/issues"
  },
  "homepage": "https://github.com/hayaishi/cc-statusline-custom#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^3.0.4",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "yaml": "^2.8.2"
  },
  "optionalDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.7"
  }
}
