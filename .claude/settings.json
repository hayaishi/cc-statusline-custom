{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/tools/claude/cc-post-edit-checks.ts",
            "timeout": 180,
            "statusMessage": "Running post-edit checks..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/tools/claude/cc-pre-bash-guard.ts",
            "timeout": 60,
            "statusMessage": "Validating command (commit/push guard)..."
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/node_modules/.bin/tsx \"$CLAUDE_PROJECT_DIR\"/tools/claude/cc-pre-edit-guard.ts",
            "timeout": 10,
            "statusMessage": "Guardrail: checks must be green before editing..."
          }
        ]
      }
    ]
  }
}
